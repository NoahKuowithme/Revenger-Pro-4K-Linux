# COUGAR Revenger Pro 4K (Compx OEM) — allow the logged-in session to talk HID.
# Reload with: sudo udevadm control --reload-rules && sudo udevadm trigger

# Wireless dongle / composite HID (observed: 3554:f5de, also 3554:f5df)
KERNEL=="hidraw*", ATTRS{idVendor}=="3554", ATTRS{idProduct}=="f5de", MODE="0660", GROUP="plugdev", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="3554", ATTRS{idProduct}=="f5df", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="3554", ATTR{idProduct}=="f5de", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="3554", ATTR{idProduct}=="f5df", MODE="0660", TAG+="uaccess"
